# Copy to .env.local and fill in. Committed as documentation —
# never put real values in this file.

# Supabase → Settings → API. Both are public: the anon key ships in the
# browser bundle, and RLS is what actually enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Bypasses RLS entirely — never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Pixel / Conversions API.
META_PIXEL_ID=
META_CAPI_TOKEN=
